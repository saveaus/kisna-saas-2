# Copy this file to .env.local and fill it in. Use a DEVELOPMENT Supabase
# project with no real client data. Never commit .env.local.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Safe in the browser: the database's access rules protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service_role / secret key. SERVER ONLY: bypasses the access rules.
# Used for `npm run seed` and for sending staff invites. Never share it or paste it in a chat.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: password for the demo logins created by `npm run seed`.
# Leave empty to generate one (it's printed when the seed finishes).
SEED_PASSWORD=
